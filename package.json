{
  "name": "mirai-compass",
  "version": "1.0.0",
  "private": true,
  "description": "みらいコンパス — 自由進度学習支援アプリケーション（GAS ウェブアプリ + GitHub Pages シェル）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/vendor/build-vendor.mjs && node tools/build-sw.mjs",
    "check": "node tools/check-secrets.mjs && node scripts/check-project.mjs",
    "check:self": "node scripts/check-project.mjs --self-test",
    "test": "node --test",
    "ci": "node tools/build-app-links.mjs --check && npm run build && node tools/vendor/verify-generated.mjs && node tools/build-sw.mjs --check && npm run check && npm test",
    "gas:install": "npm install --no-save --no-package-lock --no-audit --no-fund @google/clasp@3.3.0",
    "gas:login": "node scripts/gas-deploy.mjs login",
    "gas:status": "node scripts/gas-deploy.mjs status",
    "gas:backup": "node scripts/gas-deploy.mjs backup",
    "gas:push": "node scripts/gas-deploy.mjs push",
    "deploy": "node scripts/gas-deploy.mjs deploy",
    "build:sw": "node tools/build-sw.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "build:fonts": "node tools/fonts/build-fonts.mjs",
    "build:app-links": "node tools/build-app-links.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.0",
    "bootstrap-icons": "1.11.1",
    "chart.js": "4.5.1",
    "fabric": "5.3.0-browser",
    "sortablejs": "1.15.0",
    "sweetalert2": "11.26.25"
  },
  "engines": {
    "node": ">=20"
  }
}
