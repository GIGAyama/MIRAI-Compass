{
  "//": "ライブラリの取りこみ方。版は package.json で固定する。作り直すには npm run build",
  "generator": "tools/vendor/build-vendor.mjs",
  "scan": ["index.html", "js_core.html", "js_student.html", "js_teacher.html", "js_worksheet.html", "css.html"],
  "scanExt": [".html"],
  "targets": [
    { "out": "vendor_css.html", "css": ["bootstrap/dist/css/bootstrap.min.css"] },
    { "out": "vendor_icons.html", "icons": "bootstrap-icons" },
    {
      "out": "vendor_js.html",
      "js": [
        "bootstrap/dist/js/bootstrap.bundle.min.js",
        "sweetalert2/dist/sweetalert2.all.min.js",
        "chart.js/dist/chart.umd.js",
        "sortablejs/Sortable.min.js",
        "fabric/dist/fabric.min.js"
      ]
    }
  ]
}
